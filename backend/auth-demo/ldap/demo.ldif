# Seed tree for the flexible-auth demo.
# Applied by bitnami/openldap via LDAP_CUSTOM_LDIF_DIR after the base
# dc=oqtopus,dc=local suffix and cn=admin bind account are created.
#
# The demo user's `mail` is the identity that flows all the way through:
#   LDAP mail -> Keycloak `email` claim -> oauth2-proxy -> user-api user_id
#             -> DB users.id (seeded as approved in scripts/seed.py)

dn: ou=people,dc=oqtopus,dc=local
objectClass: organizationalUnit
ou: people

dn: uid=demo,ou=people,dc=oqtopus,dc=local
objectClass: inetOrgPerson
uid: demo
cn: OQTOPUS Demo User
sn: Demo
givenName: OQTOPUS
mail: demo@oqtopus.local
# {SSHA} hash of "demopassword" (slappasswd). Seeding a hash, not cleartext, so
# the directory never holds a {CLEARTEXT} password even for the demo user.
userPassword: {SSHA}7G9B6lJknWrpL3A5vOuHHNJDAPhPGHth

# A second user who is NOT in the admin group, to demonstrate the Admin API's
# role gate: this user authenticates fine but gets 403 from admin-api because
# they lack the oqtopus-admin realm role.
dn: uid=operator,ou=people,dc=oqtopus,dc=local
objectClass: inetOrgPerson
uid: operator
cn: OQTOPUS Operator
sn: Operator
givenName: OQTOPUS
mail: operator@oqtopus.local
# {SSHA} hash of "operatorpassword".
userPassword: {SSHA}+JxFwFg+ibPYsuurEhBWWqhzk0KW+Ocg

# Admin group. Membership here (via the Keycloak role-ldap-mapper) grants the
# `oqtopus-admin` realm role -- so only `demo` is an admin, not `operator`.
dn: ou=groups,dc=oqtopus,dc=local
objectClass: organizationalUnit
ou: groups

dn: cn=oqtopus-admin,ou=groups,dc=oqtopus,dc=local
objectClass: groupOfNames
cn: oqtopus-admin
member: uid=demo,ou=people,dc=oqtopus,dc=local
