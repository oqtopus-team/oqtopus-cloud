# Template for backend/.env (gitignored runtime file).
# Copy this file to backend/.env and edit to enable optional features.
#
#   cp backend/.env.local backend/.env

# ============================================================
# OpenTelemetry (optional)
# ============================================================
# true: send traces/metrics to a local OTel collector
# false (default): services run normally with zero overhead
OTEL_ENABLED=false

# OTLP HTTP endpoint when OTEL_ENABLED=true.
#   make-based flow (uvicorn on host):  http://localhost:4318
#   docker compose flow:                http://172.17.0.1:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
